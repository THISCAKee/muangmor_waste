# Spreadsheet that holds payment_DATA and slip (defaults to the municipality sheet)
SHEET_ID=1bAZvd9MfcUliVfUaQzxcLUNnEgyiF8Er4knQjW_KslY

# Google access — set ONE of the two options. Without either, the site can only read the sheet
# while it is still shared as "anyone with the link", and cannot accept slips.
# Option A: service account JSON on one line (sheet shared with its email as Editor; uploads need a Shared Drive folder)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Option B: OAuth as the sheet owner (works with a personal Gmail Drive). Get the token with: node scripts/google-oauth.mjs
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Drive folder ID where slip images are saved (the part after /folders/ in the folder URL)
DRIVE_FOLDER_ID=

# Signs payment orders so the amount cannot be changed in the browser. Generate with: openssl rand -hex 32
ORDER_SECRET=

# Krungthai bill payment (barcode / QR with Ref1+Ref2). When set, it replaces the PromptPay QR.
# Biller ID = municipality tax ID (13 digits) + suffix (2 digits) given by the bank, e.g. 0994000xxxxxx + 00
BILLER_TAX_ID=
BILLER_SUFFIX=
# Comp Code shown for "จ่ายบิล" in Krungthai NEXT
KTB_COMP_CODE=

# Municipality PromptPay: 13-digit tax ID (or 10-digit phone). Leave empty to hide the QR.
PROMPTPAY_ID=
# Account name shown under the QR so people can check before paying
PAYEE_NAME=

# Pay through the bank app (amount and payee pre-filled, confirmed automatically).
# opn = Opn Payments (Omise) mobile banking — needs a merchant account; use skey_test_... to try it first.
# mock = simulated bank for demos (works only with `npm run dev`). Leave empty to offer only the PromptPay QR.
PAYMENT_PROVIDER=
OPN_SECRET_KEY=
# Smallest amount the gateway accepts for mobile banking (baht)
PAYMENT_MIN_AMOUNT=20
# Public site URL the bank app returns to, e.g. https://waste.example.go.th (defaults to the request origin)
PUBLIC_URL=
